case @ucode_token.kind of
  0 = @ucode_reserved_word
| 1 = @ucode_token_break_statement
| 2 = @ucode_token_comment
| 3 = @ucode_token_continue_statement
| 4 = @ucode_token_default
| 5 = @ucode_token_doc_comment
| 6 = @ucode_token_empty_statement
| 7 = @ucode_token_escape_sequence
| 8 = @ucode_token_false
| 9 = @ucode_token_hash_bang_line
| 10 = @ucode_token_identifier
| 11 = @ucode_token_null
| 12 = @ucode_token_number
| 13 = @ucode_token_optional_chain
| 14 = @ucode_token_property_identifier
| 15 = @ucode_token_regex_flags
| 16 = @ucode_token_regex_pattern
| 17 = @ucode_token_shorthand_property_identifier
| 18 = @ucode_token_string_fragment
| 19 = @ucode_token_this
| 20 = @ucode_token_true
;


